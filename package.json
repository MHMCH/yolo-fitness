{
  "name": "yolo-fitness",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:lan": "vite --host 0.0.0.0",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "preview:lan": "vite preview --host 0.0.0.0",
    "build:rehearsal": "vue-tsc --noEmit && vite build --mode rehearsal --outDir dist-rehearsal --emptyOutDir",
    "rehearsal": "npm run build:rehearsal && vite preview --mode rehearsal --outDir dist-rehearsal --host 0.0.0.0",
    "test": "vitest run",
    "icons": "node scripts/generate-icons.mjs",
    "users": "node scripts/manage-users.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.0",
    "@lucide/vue": "^1.0.0",
    "@supabase/supabase-js": "^2.57.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.0",
    "sharp": "^0.35.5",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.0.0"
  }
}
